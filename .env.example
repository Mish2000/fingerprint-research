# Literal KEY=value. Process variables override this file. No interpolation.
# Generate private passwords and matching URLs with workbench.py init-config.
COMPOSE_PROJECT_NAME=fingerprint-research-demo
BIOMETRIC_POSTGRES_PORT=55432
IDENTITY_POSTGRES_PORT=55433
BIOMETRIC_POSTGRES_PASSWORD=replace-with-private-value
IDENTITY_POSTGRES_PASSWORD=replace-with-another-private-value
DATABASE_URL=postgresql://admin:replace-with-private-value@127.0.0.1:55432/biometric_db
IDENTITY_DATABASE_URL=postgresql://admin:replace-with-another-private-value@127.0.0.1:55433/identity_db
FPBENCH_DEMO_PROFILE=true
FPBENCH_DEVICE=cpu
SOURCEAFIS_ENABLED=true
SOURCEAFIS_SERVICE_URL=http://127.0.0.1:8765
FINGERPRINT_ENGINE_PROVIDER=sourceafis_open
FPBENCH_API_PORT=8000
FPBENCH_UI_PORT=5173
# Optional absolute local paths (never commit the populated .env):
# FPBENCH_PYTHON=
# FPBENCH_JAVA=
# FPBENCH_MAVEN=
# FPBENCH_DOCKER=
# FPBENCH_WEIGHTS_DIR=
# FPBENCH_DATASETS_ROOT=
# FPBENCH_RUNTIME_DIR=
