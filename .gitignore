# ---------- Generated data / experiment outputs ----------

# Ignore all local/generated data by default.
# Then explicitly allow the curated UI/demo assets that are required
# for a cloned repo to show Verify / Identification examples and dataset browser previews.
data/**
!data/
!data/processed/
!data/processed/ui_assets_registry.json
!data/processed/*/
!data/processed/*/ui_assets/
!data/processed/*/ui_assets/**
!data/samples/
!data/samples/catalog.json
!data/samples/catalog.schema.json
!data/samples/catalog.validation_report.json
!data/samples/README_catalog.md
!data/samples/assets/
!data/samples/assets/**

# ---------- Artifacts / benchmark evidence ----------

# Ignore all generated artifacts by default.
# Then explicitly allow only the curated benchmark bundles required by the Benchmark UI.
artifacts/**
!artifacts/
!artifacts/**/
!artifacts/reports/
!artifacts/reports/benchmark/
!artifacts/reports/benchmark/full_nist_sd300b_h5/
